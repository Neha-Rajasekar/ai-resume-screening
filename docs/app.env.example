# Copy to /home/ec2-user/app.env on the EC2 instance and fill in the values.
# The container reads it with --env-file. Never commit the real file.

# RDS endpoint from: aws rds describe-db-instances --db-instance-identifier resume-db
DATABASE_URL=mysql+pymysql://admin:YOUR_DB_PASSWORD@resume-db.xxxxxxxx.ap-southeast-2.rds.amazonaws.com:3306/resumedb?charset=utf8mb4

AWS_REGION=ap-southeast-2
S3_BUCKET=resume-screening-YOURNAME
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:resume-shortlist-ready

# Used in the SNS email link to the results page
PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP

# Any long random string (signs the flash messages cookie)
SECRET_KEY=change-me-to-a-long-random-string

# Optional tuning (defaults shown)
# TOP_K=30
# W_SEMANTIC=0.55
# W_SKILLS=0.30
# W_EXPERIENCE=0.15
